{
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2022",
    "types": ["vite/client"],
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "storybook/test": ["./node_modules/storybook/dist/test/index.d.ts"]
    }
  },
  "include": [
    ".storybook/**/*.ts",
    "src/**/*.ts",
    "src/**/*.svelte",
    "packages/workspace/src/**/*.ts",
    "packages/workspace/src/**/*.svelte",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
