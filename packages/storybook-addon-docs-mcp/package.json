{
  "name": "storybook-addon-docs-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-driven Storybook documentation MCP addon with stdio and HTTP transports.",
  "keywords": [
    "storybook-addon",
    "mcp",
    "documentation",
    "svelte"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "docs-mcp": "./dist/node/cli.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./preset": "./src/preset.ts",
    "./svelte": "./src/svelte/index.ts",
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*",
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:node": "tsc -p tsconfig.node-build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node-build.json --noEmit",
    "prepare": "pnpm build:node",
    "prepack": "pnpm build:node"
  },
  "dependencies": {
    "@storybook/mcp": "0.8.0",
    "@tmcp/adapter-valibot": "^0.1.6",
    "@tmcp/transport-stdio": "^0.4.3",
    "fast-glob": "^3.3.3",
    "highlight.js": "^11.11.1",
    "jiti": "^2.7.0",
    "jsonc-parser": "^3.3.1",
    "marked": "^18.0.6",
    "tmcp": "^1.19.4",
    "typescript": "^5.7.2",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0"
  },
  "peerDependencies": {
    "storybook": ">=9"
  },
  "peerDependenciesMeta": {
    "storybook": {
      "optional": true
    }
  },
  "storybook": {
    "displayName": "Docs MCP",
    "supportedFrameworks": [
      "svelte",
      "react",
      "vue",
      "angular",
      "web-components",
      "html",
      "preact"
    ]
  }
}
