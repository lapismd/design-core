  },
  "type": "module",
  "files": [
    "src",
    "!src/**/*.stories.*",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/*.mdx",
    "!src/**/*.example-sources.*",
    "!src/**/.npm/**",
