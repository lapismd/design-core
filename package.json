  "scripts": {
    "storybook": "WATCHPACK_POLLING=250 node scripts/with-storybook-env.mjs node scripts/storybook-run.mjs",
    "storybook:ui": "WATCHPACK_POLLING=250 node scripts/with-storybook-env.mjs node scripts/storybook-run.mjs",
    "storybook:stop": "node scripts/with-storybook-env.mjs bash scripts/storybook-stop.sh",
    "storybook:restart": "node scripts/with-storybook-env.mjs bash scripts/storybook-restart.sh",
    "storybook:check": "pnpm test:storybook && pnpm test:workspace:pointer && pnpm test:shell:pointer && pnpm test:shadcn:pointer && pnpm build-storybook && pnpm workspace:visual:audit",
    "build-storybook": "node --env-file-if-exists=.env scripts/run-turbo.mjs build:storybook",
    "build:storybook": "node -e \"require('node:fs').mkdirSync('.visual-delta/cache',{recursive:true})\" && node --max-old-space-size=6144 ./node_modules/storybook/dist/bin/dispatcher.js build --stats-json .visual-delta/cache",
    "changeset": "changeset",
    "test:unit": "vitest run --project unit",
    "test:turbo": "node --test scripts/concurrency.test.mjs scripts/turbo-cache-report.test.mjs",
    "test:release": "node --test scripts/design-core-release.test.mjs scripts/npm-command-env.test.mjs scripts/packed-audit-policy.test.mjs scripts/prepare-styles.test.mjs scripts/public-dependency-patch.test.mjs",
    "test:storybook": "vitest run --project storybook",
    "test:storybook:watch": "vitest --project storybook",
    "spec:build": "node scripts/dependency-automation/spec-policy.mjs build",
    "spec:check": "pnpm icons:check && node scripts/dependency-automation/spec-policy.mjs check",
    "spec:first": "node scripts/dependency-automation/spec-policy.mjs first",
    "spec:index": "spec-validator index",
    "spec:search": "spec-validator search",
    "spec:validate": "pnpm icons:check && node scripts/dependency-automation/spec-policy.mjs validate",
    "spec:serve": "spec-validator serve",
    "test:workspace:pointer": "node scripts/with-storybook-env.mjs playwright test -c playwright.workspace.config.ts",
    "test:shell:pointer": "node scripts/with-storybook-env.mjs playwright test -c playwright.shell.config.ts",
    "test:shadcn:pointer": "node scripts/with-storybook-env.mjs playwright test -c playwright.shadcn.config.ts",
    "test:visual": "node scripts/with-storybook-env.mjs visual-delta test --all --baseline-path-mode nested-import --external 'vendor/shadcn-svelte-docs/static/**'",
    "test:visual:affected": "node scripts/with-storybook-env.mjs visual-delta test --affected --baseline-path-mode nested-import --external 'vendor/shadcn-svelte-docs/static/**'",
    "test:ai-chat-browser": "node scripts/with-storybook-env.mjs playwright test -c playwright.ai-chat.config.ts",
    "test:visual:update": "node scripts/with-storybook-env.mjs tsx scripts/ui-generator/cli.ts visual-update",
    "test:visual:report": "playwright show-report",
    "workspace:visual:audit": "node scripts/with-storybook-env.mjs tsx scripts/workspace-visual-audit.ts",
    "workspace:visual:verify": "node scripts/with-storybook-env.mjs tsx scripts/workspace-visual-audit.ts --require-baselines",
    "visual-delta": "node scripts/with-storybook-env.mjs visual-delta",
    "packages:check": "pnpm release:check",
    "packages:pack": "node ./scripts/design-core-release.mjs pack-check",
    "package:local": "node scripts/pack-local.mjs",
    "release:check": "node ./scripts/design-core-release.mjs check",
    "release:notes": "node ./scripts/design-core-release.mjs notes",
    "release:plan": "node ./scripts/design-core-release.mjs plan",
    "release:prepare": "node ./scripts/design-core-release.mjs prepare",
    "release:publish": "node ./scripts/design-core-release.mjs publish",
    "release:verify": "node ./scripts/design-core-release.mjs verify",
    "release:version": "changeset version && pnpm install --lockfile-only && prettier package.json CHANGELOG.md --write",
    "ui": "tsx scripts/ui-generator/cli.ts",
    "ui:guide": "tsx scripts/ui-generator/cli.ts guide",
    "ui:components": "tsx scripts/ui-generator/cli.ts components",
    "ui:add": "tsx scripts/ui-generator/cli.ts add",
    "ui:add:batch": "tsx scripts/ui-generator/cli.ts add:batch",
    "ui:inspect": "tsx scripts/ui-generator/cli.ts inspect",
    "ui:doctor": "tsx scripts/ui-generator/cli.ts doctor",
    "ui:refresh": "tsx scripts/ui-generator/cli.ts refresh",
    "ui:docs": "tsx scripts/ui-generator/cli.ts docs",
    "ui:visual:tag": "tsx scripts/ui-generator/cli.ts visual:tag",
    "test-unit": "pnpm test:unit",
    "test-storybook": "pnpm test:storybook",
    "check": "pnpm spec:validate && pnpm check:types",
    "check:types": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && pnpm check:shell-consumer && pnpm check:filter-consumer && pnpm check:source-consumer",
    "check:filter-consumer": "svelte-check --tsconfig ./tsconfig.filter-consumer.json --fail-on-warnings",
    "check:shell-consumer": "svelte-check --tsconfig ./tsconfig.shell-consumer.json --fail-on-warnings",
    "check:source-consumer": "svelte-check --tsconfig ./tsconfig.source-consumer.json --fail-on-warnings",
    "fmt": "prettier . --write",
    "fmt:check": "prettier . --check",
    "check:no-tailwind": "tsx scripts/check-no-tailwind-utilities.ts",
    "ci:governance": "pnpm spec:check",
    "ci:quality": "pnpm fmt:check && pnpm check:types && pnpm check:no-tailwind",
    "ci:unit": "pnpm test:unit && pnpm test:turbo && pnpm test:release",
    "ci:storybook-static": "pnpm workspace:visual:audit -- --index=storybook-static/index.json",
    "ci:storybook-interaction": "pnpm test:storybook",
    "ci:browser-workspace": "pnpm test:workspace:pointer",
    "ci:browser-shell": "pnpm test:shell:pointer",
    "ci:browser-shadcn": "pnpm test:shadcn:pointer",
    "ci:browser-ai": "pnpm test:ai-chat-browser",
    "checks:nonvisual": "node --env-file-if-exists=.env scripts/run-turbo.mjs ci:governance ci:quality ci:unit --summarize && node --env-file-if-exists=.env scripts/run-turbo.mjs ci:storybook-static --summarize && node --env-file-if-exists=.env scripts/run-turbo.mjs ci:storybook-interaction --summarize && node --env-file-if-exists=.env scripts/run-turbo.mjs ci:browser-workspace --summarize && node --env-file-if-exists=.env scripts/run-turbo.mjs ci:browser-shell --summarize && node --env-file-if-exists=.env scripts/run-turbo.mjs ci:browser-ai --summarize && node --env-file-if-exists=.env scripts/run-turbo.mjs ci:browser-shadcn --summarize",
    "checks:release": "pnpm spec:check && pnpm check && pnpm check:no-tailwind && pnpm test:unit && pnpm test:release && pnpm build-storybook && pnpm workspace:visual:audit",
    "checks": "pnpm checks:nonvisual",
    "checks:visual": "pnpm checks:nonvisual && pnpm test:visual",
    "filter:grammar": "node scripts/generate-filter-query-parser.mjs",
    "icons:generate": "node scripts/generate-file-type-icons.mjs",
    "icons:check": "node scripts/generate-file-type-icons.mjs --check"
  },
